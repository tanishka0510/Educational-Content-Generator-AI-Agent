# Copy the required entries into the .env file for the service that uses them.
# Never commit real credentials.

# Frontend (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MULTIMEDIA_URL=http://localhost:8003

# Orchestrator_Agent/.env
DATABASE_URL=
JWT_SECRET_KEY=
FRONTEND_URL=http://localhost:3000
CONTENT_PROCESSING_URL=http://localhost:8001
EDUCATIONAL_AGENT_URL=http://localhost:8002
MULTIMEDIA_AGENT_URL=http://localhost:8003

# Content-Processing-Agent/.env
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=
FRONTEND_URL=http://localhost:3000
ORCHESTRATOR_URL=http://localhost:8000

# Educational-Content-Generator-Agent/backend/.env
GEMINI_API_KEY=
CONTENT_PROCESSING_AGENT_URL=http://localhost:8001

# Multimedia-Agent/.env (or backend/.env, according to config loading)
GROQ_API_KEY=
GEMINI_API_KEY=
POLLINATIONS_API_KEY=
EDGE_TTS_VOICE=
MULTIMEDIA_PUBLIC_URL=http://localhost:8003
